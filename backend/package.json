{
  "name": "lampiao-backend",
  "version": "1.0.0",
  "description": "Backend for the Lampiao project",
  "main": "dist/adapters/index.js",
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "start": "npm run build && node dist/adapters/index.js",
    "dev": "nodemon",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "db:migrate": "npx sequelize-cli db:migrate --config config/config.js",
    "db:seed:all": "npx sequelize-cli db:seed:all --config config/config.js",
    "db:reset": "npx sequelize-cli db:migrate:undo:all --config config/config.js && npm run db:migrate && npm run db:seed:all"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.12",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.0",
    "pg": "^8.11.3",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.17.1",
    "express-rate-limit": "^8.3.1",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.11.3",
    "sanitize-html": "^2.17.2",
    "sequelize": "^6.37.3",
    "zod": "^3.25.76"
  }
}
