# --- Server ---
PORT=3000
NODE_ENV=development

# --- Reverse proxy / HTTPS ---
# Enable when running behind Nginx/Traefik/Cloudflare/Load Balancer.
TRUST_PROXY=false

# In production, enable to force HTTP -> HTTPS redirect at app level.
FORCE_HTTPS_REDIRECT=false

# --- Local fallback (development only) ---
# When true, the API starts without sequelize.sync().
SKIP_DB_SYNC=false

# Options: sequelize | memory
BOOK_REPOSITORY=sequelize

# --- Database (MySQL / MariaDB) ---
# MariaDB works with the mysql2 driver used by Sequelize.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lampiao_api
DB_USER=root
DB_PASS=your_database_password

# --- Auth (a ser implementado na Fase P2) ---
JWT_SECRET=change_me_before_production
JWT_EXPIRES_IN=7d

# Refresh-token settings
JWT_REFRESH_SECRET=change_me_before_production_refresh
JWT_REFRESH_EXPIRES_IN=7d

# --- Frontend origins (comma separated) ---
# Example production: https://app.example.com
FRONTEND_ORIGIN=http://localhost:4200
