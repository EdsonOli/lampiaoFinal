# Environment Variables Template
# Copy to .env and fill in with your actual values

# ============================================
# NODE ENVIRONMENT
# ============================================
NODE_ENV=development
# Options: development, staging, production

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=postgres.lampiao-prod.svc.cluster.local
DB_PORT=5432
DB_USER=lampiao
DB_PASSWORD=change_me_in_production_use_strong_password
DB_NAME=lampiao_db
# DB_SSL=true  # Enable for production

# ============================================
# BACKEND API CONFIGURATION
# ============================================
API_PORT=3001
API_URL=https://api.lampiao.com
JWT_SECRET=your_jwt_secret_here_change_me_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ============================================
# FRONTEND CONFIGURATION
# ============================================
FRONTEND_URL=https://lampiao.com
FRONTEND_PORT=4000

# ============================================
# AUTHENTICATION (Google OAuth)
# ============================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=https://api.lampiao.com/auth/google/callback

# ============================================
# SECURITY & CORS
# ============================================
CORS_ORIGIN=https://lampiao.com
CORS_CREDENTIALS=true
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=info
# Options: debug, info, warn, error
SENTRY_DSN=https://your_sentry_dsn_here

# ============================================
# SESSION & COOKIES
# ============================================
SESSION_SECRET=random_session_secret_change_me
SESSION_TIMEOUT=24h

# ============================================
# THIRD-PARTY INTEGRATIONS
# ============================================
# AWS S3 (for file storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=lampiao-uploads

# Stripe (for payments, if applicable)
STRIPE_API_KEY=your_stripe_key
STRIPE_PUBLIC_KEY=your_stripe_public_key

# SendGrid (for email)
SENDGRID_API_KEY=your_sendgrid_key
SENDGRID_FROM_EMAIL=noreply@lampiao.com

# ============================================
# FEATURES FLAGS
# ============================================
FEATURE_GOOGLE_AUTH=true
FEATURE_BOOK_SERIES=true
FEATURE_POST_DRAFTS=true
FEATURE_COMMENTS_THREADING=true
FEATURE_GAMIFICATION=false

# ============================================
# PRODUCTION ONLY
# ============================================
# TLS/SSL
TLS_CERT_PATH=/etc/ssl/certs/tls.crt
TLS_KEY_PATH=/etc/ssl/private/tls.key

# Health check endpoints
HEALTH_CHECK_PATH=/health
READY_CHECK_PATH=/ready

# Backup configuration
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
