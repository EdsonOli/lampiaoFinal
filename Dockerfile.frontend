# Multi-stage Dockerfile for Lampiao Frontend (Angular 21 + SSR)
# Build stage: Compile Angular application
FROM node:22-alpine AS builder

WORKDIR /app

# Install dependencies
COPY frontend/package*.json ./
RUN npm ci

# Copy source code
COPY frontend/public ./public
COPY frontend/src ./src
COPY frontend/angular.json .
COPY frontend/tsconfig*.json ./

# Build Angular application with SSR
RUN npm run build

# Runtime stage: Minimal image with production code only
FROM node:22-alpine

WORKDIR /app

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S web -u 1001

# Install production dependencies for SSR
COPY frontend/package*.json ./
RUN npm ci --only=production && \
    npm cache clean --force

# Copy built Angular application and SSR server
COPY --from=builder /app/dist ./dist

# Change ownership to non-root user
RUN chown -R web:nodejs /app

# Switch to non-root user
USER web

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "const http=require('http');const req=http.get('http://localhost:4000',(res)=>{if(res.statusCode<200||res.statusCode>=400){process.exit(1);}res.resume();res.on('end',()=>process.exit(0));});req.on('error',()=>process.exit(1));req.setTimeout(2000,()=>{req.destroy();process.exit(1);});"

# Expose port (4000 for SSR server, 4200 for dev)
EXPOSE 4000

# Set environment
ENV NODE_ENV=production \
    PORT=4000

# Start SSR server
CMD ["npm", "run", "serve:ssr:frontend"]
